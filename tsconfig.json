{
  "compilerOptions": {
    "target": "ES2021",
    "jsx": "react-jsx",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "useDefineForClassFields": true,
    "baseUrl": ".",
    "module": "ESNext",

    /* Bundler mode */
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["src/*"],
      "@dshmarket/*": ["packages/dsh-market/src/*"],
      "@market-compat": ["packages/market-compat/src/index.ts"],
      "@market-compat/*": ["packages/market-compat/src/*"],
      "@desktop/market-compat": ["packages/market-compat/src/index.ts"],
      "@desktop/market-compat/*": ["packages/market-compat/src/*"]
    },
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,

    /* Linting */
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "references": [{ "path": "./tsconfig.node.json" }],
  "include": ["src", "packages/market-compat/src"]
}
